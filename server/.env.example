# Keep this file private. Never place API keys in the mobile app.

# Chat and code writing with Groq
CHAT_PROVIDER=groq
GROQ_API_KEY=gsk-your-new-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: required only for AI image generation
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional alternative: change CHAT_PROVIDER=openai to use OpenAI for chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

PORT=3000

# Use * during local development. For production, set your allowed origin.
APP_ORIGIN=*

# Per-IP requests allowed in a 15-minute window.
RATE_LIMIT_MAX=60

# Public creator contact used by the website.
CONTACT_WHATSAPP_URL=https://wa.me/your-number
